<Window x:Class="CrystalProjectModManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Crystal Project Mod Manager" Width="1200" Height="800" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#101D27" Foreground="#ECF3F4" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142430" BorderBrush="#263B49" BorderThickness="0,0,1,0" Padding="18,30"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><Border Background="#28514F" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="&#x25C6;" Foreground="#65D6C0" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="CRYSTAL PROJECT" Foreground="#65D6C0" FontSize="12" FontWeight="Bold"/><TextBlock Text="Mod Manager" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,32"/>
    <StackPanel x:Name="Navigation"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="0.1.0-rc1" Foreground="#A6BAC5"/><TextBlock Text="Development preview" Foreground="#A6BAC5" FontSize="12" Margin="0,6,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,26,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,22"><TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="#A6BAC5" Margin="0,8,0,0"/></StackPanel>
   <ContentControl x:Name="PageContent" Grid.Row="1"/>
   <Border x:Name="PreviewBar" Grid.Row="2" Background="#192D39" BorderBrush="#304955" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,20,0,10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="MUSIC PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#65D6C0" Margin="0,0,0,5"/><TextBlock x:Name="NowPlaying" Text="Choose a track to listen" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, ElementName=NowPlaying}"/><TextBlock x:Name="PlaybackTime" Text="Select a track, then press play. Double-click also works." Foreground="#A6BAC5" FontSize="12" Margin="0,4,0,8"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Previous" Content="&#xE892;" Style="{StaticResource PlayerButton}" ToolTip="Previous track" AutomationProperties.Name="Previous track"/><Button x:Name="PlayPause" Content="&#xE768;" Style="{StaticResource PlayerButton}" Background="#65D6C0" Foreground="#10252B" Width="46" Height="46" ToolTip="Play" AutomationProperties.Name="Play"/><Button x:Name="Next" Content="&#xE893;" Style="{StaticResource PlayerButton}" ToolTip="Next track" AutomationProperties.Name="Next track"/><Button x:Name="Stop" Content="&#xE71A;" Style="{StaticResource PlayerButton}" ToolTip="Stop and rewind" AutomationProperties.Name="Stop and rewind"/></StackPanel>
     <Slider x:Name="Seek" Grid.Row="1" Minimum="0" Maximum="1" Value="0" Margin="0,2,18,0" ToolTip="Seek preview"/>
     <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><Slider x:Name="Volume" Width="110" Minimum="0" Maximum="1" Value="0.65" ToolTip="Preview volume" AutomationProperties.Name="Preview volume"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3">
    <ProgressBar x:Name="OperationProgress" Visibility="Collapsed" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,8" Foreground="#65D6C0"/>
    <TextBlock x:Name="Status" Text="Preparing your workspace…" Foreground="#A6BAC5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=Status}"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
